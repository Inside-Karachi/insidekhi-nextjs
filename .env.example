# Copy to .env.local (or .env) and fill in values.
# PayFast is required for checkout/payment — copy live or sandbox creds from Vercel.

DATABASE_URL=
JWT_SECRET=
TICKET_SIGNING_SECRET=

# PayFast (Pakistan — Apps.net.pk / gopayfast)
# Sandbox URLs (UAT):
PAYFAST_TOKEN_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_TRANSACTION_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=
# Optional:
# PAYFAST_STORE_ID=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_PAYFAST_SUCCESS_URL=
# NEXT_PUBLIC_PAYFAST_FAILURE_URL=
